# 复制为 poc/.env（可选）。默认走本地 Ollama，无需任何 key。

# ---- 本地 Ollama（默认，测试用）----
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:latest

# ---- 或切换 DeepSeek（OpenAI 兼容；DeepSeek 无 embedding，需另配 embedding）----
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-chat

# LightRAG 工作目录（灌语料后落盘，勿提交 git）
RAG_DIR=poc/rag_data

# 500 条监测数据（缺省指向项目内）
XLS_PATH=assets/raw/2025-脱敏版本-500条.xls
