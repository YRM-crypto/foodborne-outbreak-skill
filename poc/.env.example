# 复制为 poc/.env 并填写。DeepSeek 无 embedding，故 embedding 走本地 bge-m3。

# LLM：DeepSeek（OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# Embedding：本地 sentence-transformers（首次会下载模型）
EMBEDDING_MODEL=BAAI/bge-m3

# LightRAG 工作目录（灌语料后落盘，勿提交 git）
RAG_DIR=poc/rag_data

# 500 条监测数据（缺省指向项目内）
XLS_PATH=assets/raw/2025-脱敏版本-500条.xls
